<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Sherlock.CLI</RootNamespace>
    <AssemblyName>sherlock</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sl</ToolCommandName>
    <PackageId>sherlock-tools</PackageId>
    <Authors>Mirco De Zorzi</Authors>
    <Description>Sherlock</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>

    <!-- The analyzer walks whole object graphs (dominators, histogram) over multi-GB dumps, so tune
         it for throughput: Server GC (parallel, per-core heaps) for the heavy allocation of analysis,
         and Dynamic PGO to re-optimize the hot graph-walk methods in the long-running REPL. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <None Include="runtimes/**/*.dylib;runtimes/**/*.so;runtimes/**/*.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sherlock.Core\Sherlock.Core.csproj" />
    <ProjectReference Include="..\Sherlock.Mcp\Sherlock.Mcp.csproj" />
    <!-- The live run dashboard is a Tessera TUI hosted in-process. -->
    <ProjectReference Include="..\..\..\Tessera\src\Tessera\Tessera.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

</Project>
