<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
    <!-- The build assets only copy Windows ETW/DIA DLLs; EventPipe parsing is fully managed. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" ExcludeAssets="build;buildTransitive" PrivateAssets="build; buildtransitive">
      <IncludeAssets>runtime; compile; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sherlock.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sherlock.Heap\Sherlock.Heap.csproj" />
    <ProjectReference Include="..\Sherlock.Storage\Sherlock.Storage.csproj" />
  </ItemGroup>

</Project>
